// Comprehensive test for all new type expressions in Vinglish

// Test basic function
function main() returns number begin
    return 42
end

// Test Array type syntax (both forms)
function test_array_generic() returns Array<number> begin
    return 0
end

function test_array_fixed() returns Array<number; 5> begin
    return 0
end

// Test traditional "List of" syntax still works (backward compatibility)
function test_list_of() returns List of number begin
    return 0
end

// Test HashMap type syntax
function test_hashmap() returns HashMap from text to number begin
    return 0
end

// Test Set type syntax
function test_set() returns Set of number begin
    return 0
end

// Test Tuple type syntax
function test_tuple() returns (text, number, boolean) begin
    return ("hello", 123, true)
end

// Test enhanced Result syntax with explicit error type
function test_result_explicit() returns Result<number, text> begin
    return ok 42
end

// Test shorthand Result syntax
function test_result_shorthand() returns Result of number begin
    return ok 100
end

// Test Box type for explicit heap allocation
function test_box() returns Box<number> begin
    return box 42
end

// Test Unit type
function test_unit() returns Unit begin
    return ()
end

// Test Never type (for functions that never return)
function test_never() returns Never begin
    loop
end

// Test function types
type IntToStrFunc = Function<number, text>

function apply_callback(f: IntToStrFunc, x: number) returns text begin
    return f(x)
end

// Test nested types
function test_nested() returns HashMap from text to List of Array<number> begin
    return HashMap from text to List of Array<number>
end

// Test generic types (existing functionality)
type Container<T> = HashMap from text to T

function test_generic() returns Container<number> begin
    return HashMap from text to number
end

// Test complex nested generics
type ComplexMap<K, V> = HashMap from K to List of V

function test_complex() returns ComplexMap<number, text> begin
    return HashMap from number to List of text
end

// Test that traditional type syntax still works
function test_traditional() returns List of number begin
    return [1, 2, 3]
end

// Test variable declarations with new types
function test_variables() returns number begin
    let arr be [1, 2, 3, 4, 5] // Array literal
    let map be HashMap from text to number
    let set be Set of number
    let tuple be ("test", 42, true)
    let result be ok 100
    let box_val be box 99
    let unit_val be ()
    return 42
end