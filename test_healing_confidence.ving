// Test healing confidence scoring and safety mechanisms
function main()
begin
    // Define variables first
    let x = 5
    let mistyped_value = 999   // Define a similar variable
    let mistaken = 888         // Another similar variable

    // These should trigger lexical healing with appropriate confidence
    let funtion = 42          // transposition - should suggest 'function' with high confidence
    let fction = "test"       // missing char - should suggest 'function' with moderate confidence
    let funcction = true      // duplicated char - should suggest 'function' with moderate confidence
    let FUNCTION = 3.14       // case error - should suggest 'function' with high confidence

    // These should NOT trigger healing (safety mechanism)
    let xyz = 100             // completely unrelated - should not suggest anything
    let hello_world = 200     // unrelated word - should not suggest anything

    // Test unknown identifier healing
    let result = x + mistyped  // Should trigger unknown identifier healing for 'mistyped'
                                    // Should suggest 'mistyped_value' or 'mistaken'

    print result
end