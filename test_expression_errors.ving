let x = 5
let y = 10

// Test assignment vs equality
if x = y {  // Should suggest == instead of =
    print "equal"
}

// Test bitwise vs logical operators
if x > 0 & y < 20 {  // Should suggest 'and' instead of &
    print "both true"
}

if x > 0 | y < 20 {  // Should suggest 'or' instead of |
    print "at least one true"
}

// Test wrong operator types
let z = x + "hello"  // Should suggest type conversion or different operation