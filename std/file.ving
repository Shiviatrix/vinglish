package std
module file

public foreign function ving_file_read(path: string) returns string
public foreign function ving_file_write(path: string, content: string)
public foreign function ving_dir_list(path: string) returns string

public function file_read(path: string) returns string
begin
    return ving_file_read(path)
end

public function file_write(path: string, content: string)
begin
    ving_file_write(path, content)
end

public function dir_list(path: string) returns string
begin
    return ving_dir_list(path)
end
