function main() begin
    let x be 10

    if x == 10 then begin
        print(1)
    end otherwise begin
        print(2)
    end

    when x == 10 begin
        print(3)
    end otherwise begin
        print(4)
    end

    match x
        case 10 => begin
            print(5)
        end
        otherwise begin
            print(6)
        end
end
