function classify(number n)
returns text
begin
    match n
        case 0
        begin
            return "zero"
        end
        case 42
        begin
            return "meaning of life"
        end
        otherwise
        begin
            return "other"
        end
end

function fizzbuzz(number n)
returns text
begin
    if n % 15 == 0
    then
    begin
        return "FizzBuzz"
    end
    if n % 3 == 0
    then
    begin
        return "Fizz"
    end
    if n % 5 == 0
    then
    begin
        return "Buzz"
    end
    return to_text(n)
end

function main()
begin
    println(classify(-5))
    println(classify(0))
    println(classify(42))
    let i be 1
    repeat while i <= 15
    begin
        println(fizzbuzz(i))
        i += 1
    end
end
