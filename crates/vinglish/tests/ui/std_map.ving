use std.io
use std.collections.map

function main() returns number
begin
    let m be map_new()
    insert(borrow m, "hello", 100)
    insert(borrow m, "world", 200)

    println(get(borrow m, "hello"))
    println(get(borrow m, "world"))
    println(get(borrow m, "not_found"))

    map_free(borrow m)
    return 0
end
